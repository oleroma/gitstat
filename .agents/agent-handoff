#!/usr/bin/env bash
# Keeps a feature's work on GitHub when another feature holds the repo (agent-start stopped with
# other-agent): commits it to handoff/<feature-name> and pushes that, with no PR and no build.
# Then, as Olex chose: to join, the thread working on the other feature runs
# "agent-take handoff/<feature-name>"; to wait, run "agent-start <feature-name>" from this branch
# once the other feature is merged.
# Usage: .agents/agent-handoff <feature-name>   (on main with the edits, or on the handoff branch)
source "$(dirname "$0")/lib.sh"
cd "$WORKTREE"

name="${1:-}"
[ -n "$name" ] || die "Usage: agent-handoff <feature-name>"
branch="handoff/$name"
git check-ref-format --branch "$branch" >/dev/null || die "\"$name\" isn't a valid name."

git fetch origin --prune
current="$(git symbolic-ref --quiet --short HEAD)" || die "Not on a branch."
case "$current" in
  main)
    if git show-ref --verify --quiet "refs/heads/$branch" ||
      git ls-remote --exit-code origin "refs/heads/$branch" >/dev/null; then
      die "$branch already exists. Pick another name, or switch to it and run this again."
    fi
    git switch --no-track -c "$branch"
    ;;
  "$branch") ;;
  *) die "On $current. Run this on main with the edits, or on $branch." ;;
esac

stage_all
if [ -n "$(git diff --cached --name-only)" ]; then git commit -m "Handoff: $name"; fi
[ -n "$(git rev-list -n 1 origin/main..HEAD)" ] || die "There's nothing to hand off: no edits beyond main."
git push -u origin "$branch"

finish done "Pushed $branch ($(git rev-parse --short HEAD)), with no PR and no build." \
  "To join: ask the thread working on the open feature to run: bash .agents/agent-take $branch" \
  "To wait: once that feature is merged, run agent-start $name on this branch."
