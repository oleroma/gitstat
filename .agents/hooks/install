#!/usr/bin/env bash
# Installs a build on the PC, run by agent-install with the build id and the build files.
# gitstat.exe goes to %LOCALAPPDATA%\Programs\gitstat, alongside other per-user apps, with
# a Start menu shortcut. It never stops or starts gitstat: the new exe goes next to the
# installed one as gitstat.exe.new, and gitstat swaps it in and restarts itself if it's
# running (src/self_update.rs); one that isn't running is simply replaced. A running
# gitstat that doesn't switch within 15 seconds predates self-update: its exe is renamed
# to gitstat.exe.old instead (Windows allows that while it runs) and the new one put in
# its place, to run from the next start.
# A gitstat running from anywhere else (such as build\gitstat.exe) is asked to hand over:
# gitstat.exe.handover next to its exe names the installed exe, which it starts before
# quitting. One that doesn't within 15 seconds predates handover and is left running.
# config.json there is kept; the first install takes build\config.json, so settings carry
# over. A "Start with Windows" entry is pointed at the installed exe.
# Prints "note: <text>" lines for the build summary.
set -euo pipefail

build_id="$1"
shift
exe=""
for f in "$@"; do
  case "$(basename "$f")" in gitstat.exe) exe="$f" ;; esac
done
[ -n "$exe" ] || { echo "note: no gitstat.exe in build $build_id, nothing installed."; exit 0; }

[ -n "${LOCALAPPDATA:-}" ] && [ -n "${APPDATA:-}" ] || {
  echo "note: not installed: LOCALAPPDATA or APPDATA isn't set (not Windows?)."
  exit 0
}
export MSYS_NO_PATHCONV=1
dest="$(cygpath -u "$LOCALAPPDATA")/Programs/gitstat"
dest_win="$(cygpath -w "$dest")"
# This hook sits in build/src/.agents/hooks; the repo's build folder is three levels up.
build_dir="$(cd "$(dirname "$0")/../../.." && pwd)"

ps() { powershell.exe -NoProfile -NonInteractive -Command "$1"; }

mkdir -p "$dest"

installed="$dest/gitstat.exe"
new="$dest/gitstat.exe.new"
# The installed gitstat. Windows keeps listing a running exe under its old name after a
# rename, so this also finds one already renamed to .old.
running="$(ps "@(Get-Process gitstat -ErrorAction SilentlyContinue | Where-Object { \$_.Path -like '$dest_win\\gitstat.exe*' }).Count")"
running="$(tr -d '\r' <<<"$running")"

# gitstat running from anywhere else, one exe path per line.
elsewhere="$(ps "Get-Process gitstat -ErrorAction SilentlyContinue | Where-Object { \$_.Path -and \$_.Path -notlike '$dest_win\\gitstat.exe*' } | ForEach-Object { \$_.Path } | Sort-Object -Unique")"
elsewhere="$(tr -d '\r' <<<"$elsewhere")"

# Copied under another name first, so gitstat never sees half a file.
cp -f "$exe" "$new.tmp"
if [ ! -f "$installed" ]; then
  mv -f "$new.tmp" "$installed"
  outcome="first install; gitstat runs from its next start"
elif [ "${running:-0}" = 0 ]; then
  # A build left for a gitstat that wasn't running is replaced too, or its next start
  # would swap that older build in.
  [ ! -f "$new" ] || cp -f "$new.tmp" "$new"
  mv -f "$new.tmp" "$installed"
  outcome="the installed gitstat isn't running; the new build runs from its next start"
else
  mv -f "$new.tmp" "$new"
  # gitstat looks for it every 3 seconds.
  for _ in $(seq 15); do
    [ -f "$new" ] || break
    sleep 1
  done
  if [ ! -f "$new" ]; then
    outcome="the running gitstat switched to the new build and restarted itself"
  # Taken back under another name first, so gitstat can't swap it in meanwhile.
  elif mv "$new" "$new.tmp" 2>/dev/null; then
    # A gitstat from before self-update never looks for gitstat.exe.new. Windows lets a
    # running exe be renamed, so it keeps running from .old.
    if mv -f "$installed" "$dest/gitstat.exe.old" 2>/dev/null; then
      mv -f "$new.tmp" "$installed"
      outcome="the running gitstat didn't switch within 15 seconds (it predates self-update, or runs from an exe an earlier install renamed); it keeps running, and the new build runs from its next start"
    else
      mv -f "$new.tmp" "$new"
      outcome="the running gitstat didn't switch within 15 seconds and gitstat.exe.old is in use; the new build is left as gitstat.exe.new for gitstat's next start"
    fi
  else
    outcome="the running gitstat switched to the new build and restarted itself"
  fi
fi

# Each gitstat running elsewhere hands over to the installed build, now in place.
while IFS= read -r other; do
  [ -n "$other" ] || continue
  ticket="$(cygpath -u "$other").handover"
  printf '%s' "$dest_win\gitstat.exe" >"$ticket"
  for _ in $(seq 15); do
    [ -f "$ticket" ] || break
    sleep 1
  done
  if [ -f "$ticket" ]; then
    rm -f "$ticket"
    echo "note: a gitstat running from $other didn't hand over within 15 seconds (it predates handover); quit it and start gitstat from the Start menu."
  else
    echo "note: the gitstat running from $other handed over to the installed build."
    [ "${running:-0}" != 0 ] || outcome="the installed build now runs in its place"
  fi
done <<<"$elsewhere"

if [ ! -f "$dest/config.json" ]; then
  if [ -f "$build_dir/config.json" ]; then
    cp "$build_dir/config.json" "$dest/config.json"
    echo "note: config.json copied from build\\config.json on first install."
  else
    echo "note: no config.json yet; gitstat creates one in $dest_win on start. Check its \"path\"."
  fi
fi

# Start menu shortcut, per user.
lnk_win="$(cygpath -w "$(cygpath -u "$APPDATA")/Microsoft/Windows/Start Menu/Programs/gitstat.lnk")"
ps "\$s = (New-Object -ComObject WScript.Shell).CreateShortcut('$lnk_win'); \$s.TargetPath = '$dest_win\\gitstat.exe'; \$s.WorkingDirectory = '$dest_win'; \$s.Description = 'Git repo status in the tray'; \$s.Save()"

# "Start with Windows" follows the installed exe, if it is on.
run_key='HKCU\Software\Microsoft\Windows\CurrentVersion\Run'
if reg query "$run_key" /v gitstat >/dev/null 2>&1; then
  reg add "$run_key" /v gitstat /t REG_SZ /d "\"$dest_win\\gitstat.exe\"" /f >/dev/null
  echo "note: Start with Windows now points at the installed exe."
fi

echo "note: installed to $dest_win with a Start menu shortcut; $outcome."
