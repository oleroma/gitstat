#!/usr/bin/env bash
# The parts a build of this branch builds, one per line: "exe" (the Windows tray app) and
# "apk" (the phone app in android/). A branch builds the parts its changes since main touch;
# main itself, or a checkout where main can't be found, builds both. Files no build uses
# (lib.sh pipeline_file) belong to neither.
set -euo pipefail
cd "$(dirname "$0")/../.."

exe=0
apk=0
base="$(git merge-base HEAD origin/main 2>/dev/null || true)"
if [ -n "$base" ] && [ "$base" != "$(git rev-parse HEAD)" ]; then
  while IFS= read -r f; do
    case "$f" in
      "") ;;
      .agents/* | .github/workflows/* | *.md | docs/* | .gitignore | .gitattributes | .claude/* | LICENSE*) ;;
      android/*) apk=1 ;;
      *) exe=1 ;;
    esac
  done <<<"$(git diff --name-only "$base" HEAD)"
fi
if [ "$exe" = 0 ] && [ "$apk" = 0 ]; then
  exe=1
  apk=1
fi
if [ "$exe" = 1 ]; then echo exe; fi
if [ "$apk" = 1 ]; then echo apk; fi
