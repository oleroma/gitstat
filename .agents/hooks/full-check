#!/usr/bin/env bash
# Full checks, run once per feature before the merge by agent-check (on the PC, or the fallback
# with checks), not by builds. The quick tests already ran in the builds, so
# they aren't repeated here.
set -euo pipefail
cd "$(dirname "$0")/../.."
export CARGO_TARGET_DIR=build/target

cargo clippy --locked --all-targets -- -D warnings
