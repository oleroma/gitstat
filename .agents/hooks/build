#!/usr/bin/env bash
# Builds the parts this branch builds (hooks/parts) and prints "build-file: <path> <version>"
# per build file, as the pipeline expects: gitstat.exe, the Windows tray app, and
# gitstat-phone.apk, the phone app in android/. Both share one version.
# gitstat.exe builds only on Windows; the APK needs Java 17 and the Android SDK (ANDROID_HOME).
set -euo pipefail
cd "$(dirname "$0")/../.."
# Cargo's output stays in build/, which PC builds reuse so rebuilds are incremental.
# Relative, so Git Bash never has to convert the path for cargo.
export CARGO_TARGET_DIR=build/target

# The version is the package version in Cargo.toml, bumped by hand, plus the build number.
# agent-build pc and fallback.yml set BUILD_NUMBER; the APK's versionCode is that number.
n="${BUILD_NUMBER:?Set by agent-build pc and fallback.yml from .agents/build-number}"
version="$(sed -nE 's/^version = "([^"]+)"/\1/p' Cargo.toml | head -n 1)-$n"
parts="$(bash .agents/hooks/parts)"

if grep -qx exe <<<"$parts"; then
  cargo build --release --locked
  exe="$CARGO_TARGET_DIR/release/gitstat.exe"
  [ -f "$exe" ] || { echo "No $exe: gitstat.exe builds only on Windows." >&2; exit 1; }
  echo "build-file: $exe $version"
fi

if grep -qx apk <<<"$parts"; then
  bash .agents/hooks/phone-gradle :app:assembleRelease "-PappVersion=$version" >&2
  apk=build/android/gitstat-phone.apk
  cp build/android/app/outputs/apk/release/app-release.apk "$apk"
  echo "build-file: $apk $version"
fi
