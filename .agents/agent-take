#!/usr/bin/env bash
# Merges another agent's handoff branch into this feature branch, so both features are built,
# tested and merged together. The handoff branch is kept.
# Usage: .agents/agent-take handoff/<name>   (run it again after resolving conflicts)
source "$(dirname "$0")/lib.sh"
cd "$WORKTREE"
require_feature_branch

handoff="${1:-}"
case "$handoff" in
  handoff/?*) ;;
  *) die "Usage: agent-take handoff/<name>" ;;
esac

if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
  # The run after the agent resolved conflicts.
  mapfile -t files < <(git diff --name-only --diff-filter=U)
  left="$(conflict_markers "${files[@]}")"
  [ -z "$left" ] || finish conflicts "Conflict markers are still in:" "$left" "Resolve them, then run agent-take $handoff again."
  stage_all
  git commit --no-edit
else
  [ -z "$(git status --porcelain)" ] || die "There are uncommitted changes. Commit them with agent-commit first."
  git fetch origin "+refs/heads/$handoff:refs/remotes/origin/$handoff" || die "No branch $handoff on GitHub."
  if ! git merge --no-ff --no-edit "origin/$handoff"; then
    mapfile -t files < <(git diff --name-only --diff-filter=U)
    finish conflicts "Merging $handoff into $BRANCH conflicts in:" "${files[@]}" \
      "Resolve them, then run agent-take $handoff again."
  fi
fi
git push origin "$BRANCH"

finish done "Merged $handoff into $BRANCH and pushed $(git rev-parse --short HEAD)." \
  "Build it (step 3): both features are tested in that one build."
