#!/usr/bin/env bash
# Step 3: build the feature branch. A PC build then runs agent-install on it; a failed
# install is reported in the summary but doesn't fail the build.
# Usage:
#   build/src/.agents/agent-build pc   on the PC, from the build/src worktree (AGENTS.md step 3)
#   .agents/agent-build ci             in the cloud, on the feature branch
source "$(dirname "$0")/lib.sh"
cd "$WORKTREE"

HOOKS="$WORKTREE/.agents/hooks"

# ci_build_run <sha>: prints the newest successful fallback build run on <sha> whose build files
# are still on GitHub, or nothing.
ci_build_run() {
  local run
  for run in $(gh api "repos/$SLUG/actions/workflows/fallback.yml/runs?head_sha=$1&event=workflow_dispatch&status=success&per_page=10" \
    --jq '.workflow_runs[].id'); do
    if [ "$(gh api "repos/$SLUG/actions/runs/$run/artifacts" --jq '[.artifacts[] | select(.expired | not)] | length')" -gt 0 ]; then
      echo "$run"
      return 0
    fi
  done
}

# fetch_ci_build <run> <dir>: downloads the run's build files into <dir> and sets files, names
# and version as a build on the PC would. The version is read from the build hook's
# "build-file: <path> <version>" lines in the run's job logs.
fetch_ci_build() {
  local run="$1" dir="$2" art id name job
  rm -rf "$dir"
  mkdir -p "$dir"
  while IFS= read -r art; do
    id="${art%% *}"
    name="${art#* }"
    gh api "repos/$SLUG/actions/artifacts/$id/zip" >"$dir/$name"
    files+=("$dir/$name")
    names+=("$name")
  done < <(gh api "repos/$SLUG/actions/runs/$run/artifacts" --jq '.artifacts[] | select(.expired | not) | "\(.id) \(.name)"')
  for job in $(gh api "repos/$SLUG/actions/runs/$run/jobs" --jq '.jobs[] | select(.conclusion == "success") | .id'); do
    version="$(gh api "repos/$SLUG/actions/jobs/$job/logs" | tr -d '\r' |
      sed -nE 's/^[0-9T:.Z-]+ build-file: [^ ]+ ([^ ]+)$/\1/p' | head -n 1)"
    if [ -n "$version" ]; then break; fi
  done
  [ -n "$version" ] || die "Found no build-file line in the logs of CI run $run."
  [ "${#files[@]}" -gt 0 ] || die "CI run $run has no build files left."
}

build_pc() {
  [ "$WORKTREE" -ef "$BUILD_DIR/src" ] || die "Run this from the build/src worktree, as in AGENTS.md step 3."

  local lock="$BUILD_DIR/.build-lock"
  mkdir "$lock" 2>/dev/null || die "Another build is running in build/src, or $lock was left behind. Ask Olex."
  cleanup() { rmdir "$lock" 2>/dev/null || true; }

  local commit
  commit="$(git rev-parse --short=7 HEAD)"

  # When CI already built this commit (agent-build ci while the PC was away), download and
  # install that build instead of building it again.
  local version="" line rel v files=() names=() ci_run="" built_here=1
  ci_run="$(ci_build_run "$(git rev-parse HEAD)")"
  if [ -n "$ci_run" ]; then
    built_here=0
    fetch_ci_build "$ci_run" "$BUILD_DIR/logs/ci-build"
  else
    if [ -f "$HOOKS/quick-test" ]; then
      bash "$HOOKS/quick-test" || die "Quick tests failed at $commit. Not built."
    fi

    # The repo's next build number, claimed on GitHub; the build hook makes the version from it.
    BUILD_NUMBER="$(bash "$AGENTS_DIR/build-number")" || die "Couldn't get a build number from GitHub. Not built."
    export BUILD_NUMBER

    local out_file="$BUILD_DIR/logs/build-output.txt"
    if ! bash "$HOOKS/build" >"$out_file"; then
      cat "$out_file"
      die "Build failed at $commit."
    fi
    cat "$out_file"

    # The hook prints one "build-file: <path> <version>" line per build file.
    while IFS= read -r line; do
      case "$line" in
        "build-file: "*)
          line="${line#build-file: }"
          rel="${line% *}"
          v="${line##* }"
          [ -n "$rel" ] && [ "$rel" != "$line" ] || die "Bad build-file line from the build hook: $line"
          [ -f "$WORKTREE/$rel" ] || die "Build file not found: $rel"
          files+=("$WORKTREE/$rel")
          names+=("$(basename "$rel")")
          if [ -z "$version" ]; then version="$v"; fi
          ;;
      esac
    done <"$out_file"
    [ "${#files[@]}" -gt 0 ] || die "The build hook printed no \"build-file: <path> <version>\" line."
  fi

  # One folder per build, and the newest build files directly in build/.
  local dest="$BUILD_DIR/builds/$version-$commit" old
  mkdir -p "$dest"
  cp "${files[@]}" "$dest/"
  if [ -f "$BUILD_DIR/.newest" ]; then
    while IFS= read -r old; do
      if [ -n "$old" ]; then rm -f "$BUILD_DIR/$old"; fi
    done <"$BUILD_DIR/.newest"
  fi
  cp "${files[@]}" "$BUILD_DIR/"
  printf '%s\n' "${names[@]}" >"$BUILD_DIR/.newest"
  echo "$version-$commit" >"$BUILD_DIR/.newest-build"

  # Keep the last 4 builds. Old-style build folders may hold a worktree; prune forgets those.
  ls -1dt "$BUILD_DIR"/builds/*/ | tail -n +5 | while read -r old; do rm -rf "$old"; done
  git -C "$MAIN_REPO" worktree prune

  local summary=("Built $version-$commit:") name
  if [ "$built_here" = 0 ]; then summary=("Downloaded $version-$commit from CI (https://github.com/$SLUG/actions/runs/$ci_run), not built again:"); fi
  for name in "${names[@]}"; do summary+=("File: $BUILD_DIR/$name"); done

  # Install it. agent-install prints its own result and summary; keep the summary lines.
  local out
  if out="$(bash "$AGENTS_DIR/agent-install" "$version-$commit")"; then
    while IFS= read -r line; do
      case "$line" in "result: "* | "log: "* | "Installed build "*) ;; *) summary+=("$line") ;; esac
    done <<<"$out"
  else
    summary+=("Install failed: $(grep -v -e '^result: ' -e '^log: ' <<<"$out" | head -n 1)" "Install log: $(sed -n 's/^log: //p' <<<"$out")")
  fi
  echo "$out"

  # The full checks, after the install so the phone gets the build first. A CI build of this
  # commit already ran them. When they pass, the commit is marked checked for agent-merge.
  if [ "$built_here" = 1 ]; then
    if ! bash "$HOOKS/full-check"; then
      finish checks-failed "${summary[@]}" "Full checks failed at $commit (see the log). Fix them before Olex tests."
    fi
    mark_checked "$(git rev-parse HEAD)" "Passed on the PC" ||
      die "${summary[@]}" "Full checks passed, but marking $commit checked on GitHub failed."
    summary+=("Full checks passed.")
  fi

  finish done "${summary[@]}"
}

build_ci() {
  require_feature_branch
  git fetch origin "$BRANCH"
  [ "$(git rev-parse HEAD)" = "$(git rev-parse "origin/$BRANCH")" ] ||
    die "HEAD isn't what's pushed on origin/$BRANCH. Run agent-commit first."

  local slug="$SLUG" run url
  # The run does what a PC build does: quick tests, build, full checks.
  run_fallback || die "The fallback run failed (tests, build or full checks): $RUN_URL"
  run="$RUN"
  url="$RUN_URL"

  local arts art id name dest="$BUILD_DIR/ci/$run" summary=("Built on GitHub, full checks passed: $url")
  arts="$(gh api "repos/$slug/actions/runs/$run/artifacts" --jq '.artifacts[] | "\(.id) \(.name)"')"
  [ -n "$arts" ] || die "The fallback run saved no build file: $url"
  mkdir -p "$dest"

  # Artifacts are uploaded unzipped, so each download is the build file itself.
  while IFS= read -r art; do
    id="${art%% *}"
    name="${art#* }"
    gh api "repos/$slug/actions/artifacts/$id/zip" >"$dest/$name"
    summary+=("$name: direct download link https://github.com/$slug/actions/runs/$run/artifacts/$id" "  File: $dest/$name")
  done <<<"$arts"

  finish done "${summary[@]}" "Post the links in the project thread first, then upload the files."
}

case "${1:-}" in
  pc) build_pc ;;
  ci) build_ci ;;
  *) die "Usage: agent-build pc|ci" ;;
esac
