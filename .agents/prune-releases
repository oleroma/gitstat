#!/usr/bin/env bash
# Deletes old builds: keeps the newest 20 builds, plus every build on an open PR's branch that
# main doesn't have yet, and deletes the others' build/<n> tags and pre-releases with their files.
# The commits stay in git, so an old build can be made again from its commit. The newest builds'
# tags stay, so build-number keeps counting up. Anything it can't read keeps everything.
# Uses git and GitHub only; prune.yml runs it in CI after each push to main, daily, and when
# agent-publish starts it.
# Usage: .agents/prune-releases [--dry-run]
set -euo pipefail
cd "$(dirname "$0")/.."
KEEP=20
dry=0
if [ "${1:-}" = --dry-run ]; then dry=1; fi
slug="${GITHUB_REPOSITORY:-$(git remote get-url origin | sed -E 's#\.git$##; s#.*[:/]([^/]+/[^/]+)$#\1#')}"
git fetch -q origin main
heads=()
while read -r pr; do
  [ -n "$pr" ] || continue
  git fetch -q origin "refs/pull/$pr/head"
  heads+=("$(git rev-parse FETCH_HEAD)")
done < <(gh api "repos/$slug/pulls?state=open&per_page=100" --jq '.[].number')
# The pre-releases by build number.
declare -A rel=()
page=1
while :; do
  more="$(gh api "repos/$slug/releases?per_page=100&page=$page" \
    --jq '.[] | select(.tag_name | test("^build/[0-9]+$")) | "\(.tag_name | ltrimstr("build/")) \(.id)"')"
  [ -n "$more" ] || break
  while read -r n id; do rel[$n]="$id"; done <<<"$more"
  page=$((page + 1))
done
# The build tags on GitHub, newest first, past the newest KEEP.
tags="$(git ls-remote --tags origin 'refs/tags/build/*' | sed -nE 's#^([0-9a-f]+)\s+refs/tags/build/([0-9]+)$#\2 \1#p' | sort -rn)"
[ -n "$tags" ] || exit 0
git fetch -q origin $(awk '{print $2}' <<<"$tags" | sort -u) 2>/dev/null || git fetch -q origin --tags
gone=0
while read -r n sha; do
  keep=0
  if ! git merge-base --is-ancestor "$sha" origin/main; then
    for h in "${heads[@]}"; do
      if git merge-base --is-ancestor "$sha" "$h"; then keep=1; fi
    done
  fi
  [ "$keep" = 0 ] || continue
  if [ "$dry" = 1 ]; then
    echo "Would delete build $n${rel[$n]:+ and its pre-release}."
  else
    if [ -n "${rel[$n]:-}" ]; then gh api -X DELETE "repos/$slug/releases/${rel[$n]}" >/dev/null; fi
    gh api -X DELETE "repos/$slug/git/refs/tags/build/$n" >/dev/null
  fi
  gone=$((gone + 1))
done < <(tail -n +$((KEEP + 1)) <<<"$tags")
if [ "$dry" = 1 ]; then echo "Would delete $gone old builds."; else echo "Deleted $gone old builds."; fi
