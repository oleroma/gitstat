#!/usr/bin/env bash
# Prints a build's pre-release notes: "What's new since build <m>", one line per commit
# message since the newest earlier build/<m> whose commit this build contains (merges,
# "Start <feature>" and rules-sync commits left out), then the given footer line. Reads GitHub only, so it works on the PC and in CI.
# Usage: .agents/release-notes <sha> <n> "<footer>"
set -uo pipefail
sha="$1" n="$2" footer="${3:-}"
slug="${GITHUB_REPOSITORY:-$(git remote get-url origin | sed -E 's#\.git$##; s#.*[:/]([^/]+/[^/]+)$#\1#')}"
prev="" checked=0
while read -r m tsha; do
  [[ "$m" =~ ^[0-9]+$ ]] && [ "$m" -lt "$n" ] || continue
  checked=$((checked + 1))
  [ "$checked" -le 20 ] || break
  case "$(gh api "repos/$slug/compare/$tsha...$sha" --jq .status 2>/dev/null)" in
    ahead | identical) prev="$m $tsha"; break ;;
  esac
done < <(gh api "repos/$slug/git/matching-refs/tags/build" --paginate \
  --jq '.[] | "\(.ref | sub("refs/tags/build/"; "")) \(.object.sha)"' 2>/dev/null | sort -rn)
if [ -n "$prev" ]; then
  lines="$(gh api "repos/$slug/compare/${prev#* }...$sha" --jq '.commits[]
    | select((.parents | length) < 2) | .commit.message | split("\n")[0]
    | select(startswith("Start ") or startswith("Sync shared agent rules") | not) | "- " + .' 2>/dev/null | tail -n 30)"
  if [ -n "$lines" ]; then
    printf "**What's new since build %s**\n%s\n\n" "${prev%% *}" "$lines"
  else
    printf "Same code as build %s.\n\n" "${prev%% *}"
  fi
fi
printf '%s\n' "$footer"
