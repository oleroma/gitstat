#!/usr/bin/env bash
# Step 5: bring the latest main into the feature branch, then merge the branch into main.
# Usage: .agents/agent-merge [--unbuilt]   (run it again after resolving conflicts)
#   --unbuilt: only when Olex says to merge without a build. Merges without a checked build and
#   without asking to test again; the merge commit's title ends in "(unbuilt)", so the next
#   branch's build also builds the parts this one changed (hooks/parts).
UNBUILT=0
if [ "${1:-}" = --unbuilt ]; then UNBUILT=1; shift; fi
source "$(dirname "$0")/lib.sh"
cd "$WORKTREE"
require_feature_branch

MAX_ATTEMPTS=3
# Conflict rounds are counted per branch in .git, so nothing is committed or pushed.
attempts_file="$(git rev-parse --path-format=absolute --git-path "agent-merge-attempts-${BRANCH//\//-}")"
files_file="$attempts_file.files"
attempts="$(cat "$attempts_file" 2>/dev/null || echo 0)"

merge_into_main() {
  if [ "$(git rev-parse HEAD)" != "$(git rev-parse "origin/$BRANCH")" ]; then
    git push origin "$BRANCH"
  fi
  local n
  n="$(pr_number "$BRANCH")"
  [ -n "$n" ] || die "No open PR from $BRANCH into main."
  pr_ready "$n"
  local title=()
  if [ "$UNBUILT" = 1 ]; then title=(-f "commit_title=Merge pull request #$n from $BRANCH (unbuilt)"); fi
  gh api -X PUT "repos/$SLUG/pulls/$n/merge" -f merge_method=merge "${title[@]}" >/dev/null ||
    die "GitHub refused to merge PR #$n, most likely because main moved meanwhile. Run agent-merge again."
  rm -f "$attempts_file" "$files_file"
  if [ "$UNBUILT" = 1 ]; then
    finish done "Merged $BRANCH into main unbuilt: https://github.com/$SLUG/pull/$n" \
      "The next build of a branch made from main after this builds its parts too." "The feature branch is kept."
  fi
  finish done "Merged $BRANCH into main: https://github.com/$SLUG/pull/$n" "The feature branch is kept."
}

# has_build <sha>: true if <sha> was built (a build/<n> tag is on it) or its full checks passed.
has_build() { checked "$1" || [ -n "$(newest_build_tag "$1")" ]; }

# built <test>: true if the branch's last commit passes <test> (has_build: it was built; checked:
# its full checks passed). A merge of main that changed nothing this feature changed counts as
# its feature commit.
built() {
  "$1" "$(git rev-parse HEAD)" && return 0
  git rev-parse -q --verify HEAD^2 >/dev/null &&
    git merge-base --is-ancestor HEAD^2 origin/main &&
    "$1" "$(git rev-parse HEAD^1)"
}

# built_but_pipeline <test>: true if the branch's newest commit that passes <test> (as in built) is
# followed only by commits that change pipeline files or documentation (lib.sh pipeline_file):
# those need no new build or checks, since Olex tests pipeline changes himself.
built_but_pipeline() {
  local c base last="" f
  base="$(git merge-base HEAD origin/main)"
  while read -r c; do
    if "$1" "$c"; then last="$c"; break; fi
  done < <(git rev-list --first-parent "$base..HEAD")
  [ -n "$last" ] || return 1
  while IFS= read -r f; do
    if [ -n "$f" ] && ! pipeline_file "$f"; then return 1; fi
  done < <(git log --first-parent --no-merges --format= --name-only "$last..HEAD")
}

# docs_only: true if everything the branch changed since main is documentation (*.md files
# and docs/), which no build uses, so such a branch merges without a build.
docs_only() {
  local f any=0
  while IFS= read -r f; do
    any=1
    case "$f" in *.md | docs/*) ;; *) return 1 ;; esac
  done < <(git diff --name-only "$(git merge-base HEAD origin/main)" HEAD)
  [ "$any" = 1 ]
}

git fetch origin

# A merge is in progress: this is the run after the agent resolved conflicts.
if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
  if [ -f "$files_file" ]; then
    mapfile -t files <"$files_file"
  else
    mapfile -t files < <(git diff --name-only --diff-filter=U)
  fi
  left=""
  for f in "${files[@]}"; do
    if [ -f "$f" ] && grep -qE '^(<<<<<<<|>>>>>>>)( |$)' "$f"; then left="$left$f"$'\n'; fi
  done
  [ -z "$left" ] || finish stuck "Conflict markers are still in:" "${left%$'\n'}"
  git add -A -- "${files[@]}"
  unmerged="$(git diff --name-only --diff-filter=U)"
  [ -z "$unmerged" ] || finish stuck "Still unmerged:" "$unmerged"
  git commit --no-edit
  git push origin "$BRANCH"
  rm -f "$files_file"
  finish needs-testing "Conflicts resolved, committed and pushed." \
    "Build again (step 3). Once Olex says it still works, run agent-merge again."
fi

# A branch that changed only pipeline files or documentation since main needs no build or full
# checks, and neither do such commits after the branch's last build: Olex tests pipeline changes
# himself (lib.sh only_pipeline_changes, built_but_pipeline).
[ "$UNBUILT" = 1 ] || docs_only || built has_build || only_pipeline_changes || built_but_pipeline has_build || finish not-built "$(git rev-parse --short HEAD) has no build." \
  "Build it (step 3) and have Olex test it, then run agent-merge again."
# Builds don't run the full checks: they run once before the merge (agent-check), or earlier when
# Olex says "check"; a check of this same commit counts.
[ "$UNBUILT" = 1 ] || docs_only || built checked || only_pipeline_changes || built_but_pipeline checked || finish needs-checks "$(git rev-parse --short HEAD) is built but hasn't had its full checks." \
  "Run them on the PC: agent-check pc $BRANCH (when the PC is offline: agent-check ci $BRANCH), then run agent-merge again."

# main hasn't moved since the branch last took it in.
if git merge-base --is-ancestor origin/main HEAD; then
  merge_into_main
fi

base="$(git merge-base HEAD origin/main)"
overlap="$(comm -12 \
  <(git diff --name-only "$base" HEAD | sort) \
  <(git diff --name-only "$base" origin/main | sort) | grep -v '^$' || true)"
# Files no build uses (lib.sh pipeline_file) don't change what Olex tested.
overlap="$(while IFS= read -r f; do
  if [ -n "$f" ] && ! pipeline_file "$f"; then echo "$f"; fi
done <<<"$overlap")"

if git merge --no-edit origin/main; then
  git push origin "$BRANCH"
  if [ -n "$overlap" ] && [ "$UNBUILT" = 0 ] && ! docs_only; then
    finish needs-testing "Merged the latest main. It changed files this feature also changed:" "$overlap" \
      "Build again (step 3). Once Olex says it still works, run agent-merge again."
  fi
  merge_into_main
fi

unmerged="$(git diff --name-only --diff-filter=U)"
[ -n "$unmerged" ] || die "git merge failed without conflicts."
attempts=$((attempts + 1))
echo "$attempts" >"$attempts_file"
printf '%s\n' "$unmerged" >"$files_file"
if [ "$attempts" -gt "$MAX_ATTEMPTS" ]; then
  finish stuck "Conflicts again after $MAX_ATTEMPTS attempts, in:" "$unmerged"
fi
finish conflicts "Conflicts (attempt $attempts of $MAX_ATTEMPTS) in:" "$unmerged" \
  "Resolve them, then run agent-merge again."
