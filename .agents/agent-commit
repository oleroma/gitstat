#!/usr/bin/env bash
# Step 2: commit all changes with the agent's message and push.
# Usage: .agents/agent-commit "<message>"
source "$(dirname "$0")/lib.sh"
cd "$WORKTREE"
require_feature_branch

message="${1:-}"
[ -n "$message" ] || die "Usage: agent-commit \"<message>\""

git add -A
staged="$(git diff --cached --name-only)"
if grep -q '^build/' <<<"$staged"; then
  git reset -q -- build/ # only unstages; the files stay as they are
  die "Files under build/ were about to be committed, so build/ isn't gitignored. Tell Olex."
fi

if [ -z "$staged" ]; then
  committed="Nothing new to commit."
else
  git commit -m "$message"
  committed="Committed $(git rev-parse --short HEAD)."
fi
git push origin "$BRANCH"

finish done "$committed Pushed $BRANCH."
